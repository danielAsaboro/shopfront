# Copy to .env and fill in. Everything is optional: with no values the app runs on
# synthetic demo events (clearly labelled in the UI) and a time-of-day rules classifier.
# `python -m scripts.demo` ignores the shop, Ring-mode and data-dir values here and runs its own demo shop.

SHOP_NAME=Corner Bakery
SHOP_TIMEZONE=America/Los_Angeles
# Posted hours Monday..Sunday, 24h clock: "open-close" or "closed"
SHOP_HOURS=8-18,8-18,8-18,8-18,8-19,9-16,closed

# Ring: "synthetic" (default) or "live" (Ring Partner API at api.amazonvision.com)
RING_MODE=synthetic
# Live auth, pick ONE:
#  a) Developer Playground access token (~30 min): https://developer.amazon.com/ring/console/playground
RING_ACCESS_TOKEN=
#  b) Refresh token from account linking + your app's client credentials (auto-renews, rotates)
RING_REFRESH_TOKEN=
RING_CLIENT_ID=
RING_CLIENT_SECRET=
# Empty = first camera or doorbell the token can see
RING_DEVICE_ID=
# Your Ring account ID (GET /v1/users/me, data.id). Webhooks for any other account are ignored.
# Empty = learned from the live token.
RING_ACCOUNT_ID=
# Event History filter (Ring composite syntax, e.g. ding,motion.human)
RING_EVENT_TYPES=ding,motion
# Webhook signing key from partner onboarding; without it /webhooks/ring refuses everything (503).
# DEMO ONLY: "demo-key" lets scripts/feed_webhook.py sign replays on this machine. Anyone who knows it
# can sign a webhook, so replace it with your real key before /webhooks/ring is reachable from outside.
RING_HMAC_KEY=demo-key

# Classifier: auto (Bedrock if AWS credentials resolve, else rules) | rules | bedrock
CLASSIFIER=auto
AWS_REGION=us-east-1
# Any Bedrock vision model you have access to; check with:
#   aws bedrock list-inference-profiles --region us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# AWS credentials come from the normal AWS chain (aws login / SSO / env vars). Don't put keys here.

# Where tokens, the webhook log and the classification cache live (git-ignored)
SHOPFRONT_DATA_DIR=.data
# Door frames (pictures of people) are deleted after this many days. Empty = 30; 0 keeps them.
SHOPFRONT_FRAME_DAYS=30

# Phones and other computers: run `uvicorn app.main:app --host 0.0.0.0`, open /setup on this computer for
# a 6-digit code, and enter it when the phone asks. This computer (127.0.0.1) never needs a code.
# Host names the app may be reached by besides localhost and IP addresses, comma-separated
# (e.g. shop-mac.local). Other names are refused to stop DNS-rebinding pages.
SHOPFRONT_ALLOWED_HOSTS=

# Ring webhooks without a laptop on the internet (docs/aws.md): deploy infra/template.yaml, register its
# WebhookUrl with Ring, then read the webhooks from its DynamoDB table. Empty or "file" = .data/ring-webhooks.jsonl.
SHOPFRONT_WEBHOOK_STORE=
# The stack's WebhookTableName output, its region if not AWS_REGION, and its ShopId parameter
SHOPFRONT_WEBHOOK_TABLE=
SHOPFRONT_WEBHOOK_REGION=
SHOPFRONT_SHOP_ID=shop
