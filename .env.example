# Copy to .env and fill in. Everything is optional: with no values the app
# runs on synthetic Ring data and a rule-based classifier.

SHOP_NAME=Corner Bakery
SHOP_TIMEZONE=America/Los_Angeles

# Ring: "mock" (default, synthetic events) or "partner" (Ring Partner API sandbox)
RING_MODE=mock
RING_API_BASE=
RING_TOKEN_URL=
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_DEVICE_ID=

# Classifier: auto (Bedrock if AWS credentials resolve, else stub) | stub | bedrock
CLASSIFIER=auto
AWS_REGION=us-east-1
# Any Bedrock vision model you have access to; check with:
#   aws bedrock list-inference-profiles --region us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# AWS credentials come from the normal AWS chain (aws login / SSO / env vars). Don't put keys here.
